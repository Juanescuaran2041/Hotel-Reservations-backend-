# Copy the variable names into your host (Railway > Variables). Never commit real values.
# Required: random string, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma separated list of frontend origins allowed by CORS (your Vercel URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Optional: creates an ADMIN account at startup when both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=
