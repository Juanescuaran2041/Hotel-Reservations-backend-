# Variables read by the application. In AWS they are stored in SSM Parameter Store (see README, "Deploy on AWS").
# Never commit real values.

# Required: random string, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# Supabase "Session pooler" connection (Connect > JDBC). The user carries the project ref: postgres.<ref>
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
# Comma separated list of frontend origins allowed by CORS (your CloudFront / Vercel URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# Optional: creates an ADMIN account at startup when both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=
